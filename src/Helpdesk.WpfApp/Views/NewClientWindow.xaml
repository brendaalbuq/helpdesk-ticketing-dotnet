<Window x:Class="Helpdesk.WpfApp.Views.NewClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novo Cliente"
        Height="360"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Novo Cliente"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="Registo de cliente para assistencias tecnicas"
                       Foreground="#64748B"
                       Margin="0,4,0,18" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Nome" VerticalAlignment="Center" Margin="0,0,12,10" />
            <TextBox x:Name="FullNameBox"
                     Grid.Column="1"
                     Margin="0,0,0,10" />

            <TextBlock Grid.Row="1" Text="Email" VerticalAlignment="Center" Margin="0,0,12,10" />
            <TextBox x:Name="EmailBox"
                     Grid.Row="1"
                     Grid.Column="1"
                     Margin="0,0,0,10" />

            <TextBlock Grid.Row="2" Text="Telefone" VerticalAlignment="Center" Margin="0,0,12,10" />
            <TextBox x:Name="PhoneBox"
                     Grid.Row="2"
                     Grid.Column="1"
                     Margin="0,0,0,10" />

            <TextBlock Grid.Row="3" Text="NIF" VerticalAlignment="Center" Margin="0,0,12,10" />
            <TextBox x:Name="TaxNumberBox"
                     Grid.Row="3"
                     Grid.Column="1"
                     Margin="0,0,0,10" />
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Cancelar"
                    Width="100"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click" />
            <Button Content="Criar Cliente"
                    Width="120"
                    Background="#2563EB"
                    Foreground="White"
                    Click="CreateButton_Click" />
        </StackPanel>
    </Grid>
</Window>
