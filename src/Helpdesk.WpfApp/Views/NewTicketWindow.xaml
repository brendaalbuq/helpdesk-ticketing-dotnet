<Window x:Class="Helpdesk.WpfApp.Views.NewTicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novo Ticket"
        Height="520"
        Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Novo Ticket"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="Registo de nova assistencia tecnica"
                       Foreground="#64748B"
                       Margin="0,4,0,18" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Cliente" VerticalAlignment="Center" Margin="0,0,12,10" />
            <ComboBox x:Name="ClientBox"
                      Grid.Column="1"
                      DisplayMemberPath="FullName"
                      SelectionChanged="ClientBox_SelectionChanged"
                      Margin="0,0,0,10" />

            <TextBlock Grid.Row="1" Text="Produto" VerticalAlignment="Center" Margin="0,0,12,10" />
            <ComboBox x:Name="ProductBox"
                      Grid.Row="1"
                      Grid.Column="1"
                      Margin="0,0,0,10" />

            <TextBlock Grid.Row="2" Text="Tipo" VerticalAlignment="Center" Margin="0,0,12,10" />
            <ComboBox x:Name="TypeBox"
                      Grid.Row="2"
                      Grid.Column="1"
                      Margin="0,0,0,10" />

            <TextBlock Grid.Row="3" Text="Prioridade" VerticalAlignment="Center" Margin="0,0,12,10" />
            <ComboBox x:Name="PriorityBox"
                      Grid.Row="3"
                      Grid.Column="1"
                      Margin="0,0,0,10" />

            <TextBlock Grid.Row="4" Text="Assunto" VerticalAlignment="Center" Margin="0,0,12,10" />
            <TextBox x:Name="SubjectBox"
                     Grid.Row="4"
                     Grid.Column="1"
                     Margin="0,0,0,10" />

            <TextBlock Grid.Row="5" Text="Descricao" VerticalAlignment="Top" Margin="0,4,12,0" />
            <TextBox x:Name="DescriptionBox"
                     Grid.Row="5"
                     Grid.Column="1"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" />
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Cancelar"
                    Width="100"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click" />
            <Button Content="Criar Ticket"
                    Width="120"
                    Background="#2563EB"
                    Foreground="White"
                    Click="CreateButton_Click" />
        </StackPanel>
    </Grid>
</Window>
